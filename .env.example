# MCP-Debugger Environment Variables
# Copy this to .env and fill in your values

# ================================
# REQUIRED - MCP API Key
# ================================
# Generate a secure random key for authentication
MCP_API_KEY=your-secure-api-key-here

# ================================
# BROWSERLESS CONFIGURATION
# ================================
# Your Browserless.io API token
# Get it from: https://www.browserless.io/account
BROWSERLESS_TOKEN=YOUR_BROWSERLESS_TOKEN_HERE

# Browserless API URL (optional, defaults to wss://chrome.browserless.io)
BROWSERLESS_URL=wss://chrome.browserless.io

# ================================
# FIREBASE STORAGE CONFIGURATION
# ================================
# OPTION 1: Service Account JSON (Recommended)
# Get from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Paste the entire JSON as a single line string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# OPTION 2: Simple credentials (Alternative)
# Firebase project ID
FIREBASE_PROJECT_ID=your-project-id

# Firebase storage bucket name
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ================================
# OPTIONAL - VISUAL DEBUGGING
# ================================
# Enable Playwright trace recording (for debugging)
ENABLE_TRACE_RECORDING=false

# Enable video recording (only works with local browser, not Browserless)
ENABLE_VIDEO_RECORDING=false

# Auto-capture screenshot after each action
AUTO_SCREENSHOT_AFTER_ACTION=false

# ================================
# OPTIONAL - SESSION CONFIGURATION
# ================================
# Session timeout in milliseconds (default: 1800000 = 30 minutes)
SESSION_TIMEOUT_MS=1800000

# Maximum concurrent sessions (default: 50)
MAX_SESSIONS=50

# ================================
# OPTIONAL - GEMINI AI (for debug_analyze_visual tool)
# ================================
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ================================
# RAILWAY DEPLOYMENT
# ================================
# Railway automatically sets PORT
# PORT=3000
